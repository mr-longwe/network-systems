# Local Edge Video Monitoring System Configuration

# Server Settings
EDGE_HOST=0.0.0.0
EDGE_PORT=8000
EDGE_DEBUG=false

# Application Paths
DATA_DIR=data
RECORDINGS_DIR=data/recordings
DATABASE_PATH=data/edge_system.db

# Video Ingestion & Processing Defaults
DEFAULT_FPS=10
DEFAULT_FRAME_WIDTH=640
DEFAULT_FRAME_HEIGHT=480
MOTION_THRESHOLD=25
MOTION_MIN_AREA=500
POST_MOTION_RECORD_SECONDS=5

# Security Settings (To be expanded in Phase 8)
AUTH_ENABLED=false
SECRET_KEY=change-this-in-production-use-a-strong-secret-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-secure-password

